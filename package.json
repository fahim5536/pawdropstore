    "@types/pg": "^8.20.0",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.18.0",
    "core-js": "^3.37.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "firebase": "^12.14.0",
    "goober": "^2.1.14",
    "gsap": "^3.15.0",
    "jquery": "^4.0.0",
    "keen-slider": "^6.8.6",
