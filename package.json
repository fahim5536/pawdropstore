{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "node sync-html.cjs && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "build:webpack": "webpack --mode production",
    "dev:webpack": "webpack serve --mode development --port=3000 --host=0.0.0.0",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "update-brands": "node update_brands.js"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
